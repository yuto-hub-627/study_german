{
  "name": "study-german",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply study-german --remote",
    "db:migrate:local": "wrangler d1 migrations apply study-german --local",
    "worker:dev": "npm run build && wrangler dev"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250610.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.4",
    "wrangler": "^4.20.0"
  }
}
